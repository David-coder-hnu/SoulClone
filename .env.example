# Application
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (local non-Docker development defaults to SQLite when omitted)
DATABASE_URL=postgresql+asyncpg://soulclone:soulclone_secret@localhost:5432/soulclone
DB_PASSWORD=soulclone_secret

# Redis (use "memory" for local development without Redis)
REDIS_URL=redis://localhost:6379/0

# LLM APIs
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o

# Security (replace with a random value of at least 32 characters)
SECRET_KEY=change-this-to-a-random-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300

# Frontend (used by Docker Compose and standalone Vite)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000

# Optional: AWS S3 for production file storage
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_BUCKET=soulclone-uploads
